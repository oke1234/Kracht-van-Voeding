{
  "expo": {
    "name": "Kracht-van-Voeding",
    "slug": "Kracht-van-Voeding",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.casper.krachtvvoeding",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.casper.krachtvoeding",
      "versionCode": 5,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d040475e-4dd2-42f9-bd41-15846e0437ee",
      "checkAutomatically": "NEVER"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d040475e-4dd2-42f9-bd41-15846e0437ee"
      }
    },
    "owner": "yourfutureteam",
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#4CAF50",
          "defaultChannel": "supplement-reminders"
        }
      ]
    ]
  }
}
